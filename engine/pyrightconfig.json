{
  "include": ["app", "scripts", "check_agentbay_config.py", "test_sandbox_config.py"],
  "extraPaths": ["."],
  "typeCheckingMode": "standard",
  "pythonVersion": "3.14",
  "venvPath": ".",
  "venv": ".venv",
  "reportUnannotatedClassAttribute": "error",
  "reportAny": "error",
  "exclude": [
    "**/skill_creator_files/**",
    "**/__pycache__/**",
    ".venv/**",
    "agent_template/**",
    "agent_templates/**"
  ]
}
