ARG OPENCLAW_BASE_IMAGE=node:26.12.1-bookworm-slim
FROM ${OPENCLAW_BASE_IMAGE}

ARG OPENCLAW_VERSION=2026.10.6
ARG OPENCLAW_SHA256=sha256:b13fc9f1221e185451573a435ff31bdeb8c5875f569e6f41008198708ca2359f
ARG TINI_VERSION=0.19.0-1+b3
ARG CA_CERTIFICATES_VERSION=20230311+deb12u1
ARG CURL_VERSION=7.88.1-10+deb12u15
ARG LIBCURL4_VERSION=7.88.1-10+deb12u15
ARG BASH_VERSION=5.2.15-2+b13
ARG LIBICU72_VERSION=72.1-3+deb12u1
ARG GOGCLI_VERSION=0.46.0
ARG GOGCLI_SHA256=sha256:9ae69d117cef895aa1c50b5859d7d3def45c5580886b25dc1c7f3cfe128ed0dd

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    "bash=${BASH_VERSION}" \
    "ca-certificates=${CA_CERTIFICATES_VERSION}" \
    "curl=${CURL_VERSION}" \
    "libcurl4=${LIBCURL4_VERSION}" \
    "libicu72=${LIBICU72_VERSION}" \
    "tini=${TINI_VERSION}" \
    && rm -rf /var/lib/apt/lists/* \
    && npm pack "openclaw@${OPENCLAW_VERSION}" --pack-destination /tmp \
    && OPENCLAW_TARBALL="/tmp/openclaw-${OPENCLAW_VERSION}.tgz" \
    && test -f "$OPENCLAW_TARBALL" \
    && printf '%s  %s\n' "${OPENCLAW_SHA256#sha256:}" "$OPENCLAW_TARBALL" > /tmp/openclaw.tgz.sha256 \
    && sha256sum -c /tmp/openclaw.tgz.sha256 \
    && npm install -g "$OPENCLAW_TARBALL" \
    && rm -f "$OPENCLAW_TARBALL" /tmp/openclaw.tgz.sha256 \
    && curl -fsSL \
    "https://github.com/openclaw/gogcli/releases/download/v${GOGCLI_VERSION}/gogcli_${GOGCLI_VERSION}_linux_arm64.tar.gz" \
    -o /tmp/gogcli.tar.gz \
    && printf '%s  %s\n' "${GOGCLI_SHA256#sha256:}" /tmp/gogcli.tar.gz > /tmp/gogcli.tar.gz.sha256 \
    && sha256sum -c /tmp/gogcli.tar.gz.sha256 \
    && tar -xzf /tmp/gogcli.tar.gz -C /usr/local/bin ./gog \
    && chmod 0755 /usr/local/bin/gog \
    && rm -f /tmp/gogcli.tar.gz /tmp/gogcli.tar.gz.sha256 \
    && gog --version \
    && rm -rf /root/.npm

COPY --chown=root:root docker/openclaw/patch-openclaw-sqlite-exit.cjs /usr/local/bin/patch-openclaw-sqlite-exit.cjs
RUN node /usr/local/bin/patch-openclaw-sqlite-exit.cjs "$(npm root --global)/openclaw"

COPY --chown=node:node docker/openclaw/bootstrap-officecli.sh /usr/local/bin/bootstrap-officecli.sh
COPY --chown=node:node docker/openclaw/validate-gogcli.sh /usr/local/bin/validate-gogcli.sh
RUN chmod 0755 /usr/local/bin/bootstrap-officecli.sh \
    && chmod 0755 /usr/local/bin/validate-gogcli.sh

ENV OFFICECLI_SKIP_UPDATE=1 \
    OFFICECLI_NO_AUTO_RESIDENT=1

USER node
ENTRYPOINT ["tini", "-s", "--", "/usr/local/bin/bootstrap-officecli.sh"]
CMD ["/usr/local/bin/validate-gogcli.sh", "openclaw", "gateway"]
