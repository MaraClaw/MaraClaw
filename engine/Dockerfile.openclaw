ARG OPENCLAW_BASE_IMAGE=node:26.7.0-bookworm-slim
FROM ${OPENCLAW_BASE_IMAGE}

ARG TENCENTDB_PLUGIN_VERSION=1.0.1
ARG OPENCLAW_VERSION=2026.7.1-2
ARG OPENCLAW_SHA256=sha256:5bb525f36f471a41239615d321c441778c7e1c007018ed6d84b795be77803276
ARG TINI_VERSION=0.19.0-1+b3
ARG CA_CERTIFICATES_VERSION=20230311+deb12u1
ARG CURL_VERSION=7.88.1-10+deb12u15
ARG LIBCURL4_VERSION=7.88.1-10+deb12u15
ARG BASH_VERSION=5.2.15-2+b13
ARG LIBICU72_VERSION=72.1-3+deb12u1
ARG GOGCLI_VERSION=0.36.0
ARG GOGCLI_SHA256=sha256:f68e3c35c9364dea5a4e515d13a23ab30ded46401c90d89e2953dca395d7fe42

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    "bash=${BASH_VERSION}" \
    "ca-certificates=${CA_CERTIFICATES_VERSION}" \
    "curl=${CURL_VERSION}" \
    "libcurl4=${LIBCURL4_VERSION}" \
    "libicu72=${LIBICU72_VERSION}" \
    "tini=${TINI_VERSION}" \
    && rm -rf /var/lib/apt/lists/* \
    && npm pack "openclaw@${OPENCLAW_VERSION}" --pack-destination /tmp \
    && OPENCLAW_TARBALL="/tmp/openclaw-${OPENCLAW_VERSION}.tgz" \
    && test -f "$OPENCLAW_TARBALL" \
    && printf '%s  %s\n' "${OPENCLAW_SHA256#sha256:}" "$OPENCLAW_TARBALL" > /tmp/openclaw.tgz.sha256 \
    && sha256sum -c /tmp/openclaw.tgz.sha256 \
    && npm install -g "$OPENCLAW_TARBALL" \
    && rm -f "$OPENCLAW_TARBALL" /tmp/openclaw.tgz.sha256 \
    && curl -fsSL \
    "https://github.com/openclaw/gogcli/releases/download/v${GOGCLI_VERSION}/gogcli_${GOGCLI_VERSION}_linux_arm64.tar.gz" \
    -o /tmp/gogcli.tar.gz \
    && printf '%s  %s\n' "${GOGCLI_SHA256#sha256:}" /tmp/gogcli.tar.gz > /tmp/gogcli.tar.gz.sha256 \
    && sha256sum -c /tmp/gogcli.tar.gz.sha256 \
    && tar -xzf /tmp/gogcli.tar.gz -C /usr/local/bin ./gog \
    && chmod 0755 /usr/local/bin/gog \
    && rm -f /tmp/gogcli.tar.gz /tmp/gogcli.tar.gz.sha256 \
    && gog --version \
    && mkdir -p /opt/openclaw-plugin-cache \
    && chown -R node:node /opt/openclaw-plugin-cache

USER node
RUN npm pack "@tencentdb-agent-memory/memory-tencentdb@${TENCENTDB_PLUGIN_VERSION}" \
        --pack-destination /opt/openclaw-plugin-cache \
    && TARBALL="$(find /opt/openclaw-plugin-cache -maxdepth 1 -name '*.tgz' -print -quit)" \
    && test -n "$TARBALL" \
    && mv "$TARBALL" /opt/openclaw-plugin-cache/memory-tencentdb.tgz \
    && sha256sum /opt/openclaw-plugin-cache/memory-tencentdb.tgz \
        > /opt/openclaw-plugin-cache/memory-tencentdb.tgz.sha256 \
    && tar -xzf /opt/openclaw-plugin-cache/memory-tencentdb.tgz \
        -C /opt/openclaw-plugin-cache \
        package/scripts/openclaw-after-tool-call-messages.patch.sh \
    && mv /opt/openclaw-plugin-cache/package/scripts/openclaw-after-tool-call-messages.patch.sh \
        /opt/openclaw-plugin-cache/openclaw-after-tool-call-messages.patch.sh \
    && rm -rf /opt/openclaw-plugin-cache/package

USER root
COPY --chown=node:node docker/openclaw/bootstrap-officecli.sh /usr/local/bin/bootstrap-officecli.sh
COPY --chown=node:node docker/openclaw/bootstrap-memory-tencentdb.sh /usr/local/bin/bootstrap-memory-tencentdb.sh
COPY --chown=node:node docker/openclaw/validate-gogcli.sh /usr/local/bin/validate-gogcli.sh
COPY --chown=root:root docker/openclaw/verify-tencentdb-openclaw-patch.sh /usr/local/bin/verify-tencentdb-openclaw-patch.sh
COPY --chown=root:root docker/openclaw/classify-tencentdb-openclaw-hook.cjs /usr/local/bin/classify-tencentdb-openclaw-hook.cjs
RUN chmod 0755 /usr/local/bin/bootstrap-officecli.sh \
    && chmod 0755 /usr/local/bin/bootstrap-memory-tencentdb.sh \
    && chmod 0755 /usr/local/bin/validate-gogcli.sh \
    && chmod 0755 /opt/openclaw-plugin-cache/openclaw-after-tool-call-messages.patch.sh
RUN chmod 0755 /usr/local/bin/verify-tencentdb-openclaw-patch.sh
RUN OPENCLAW_ROOT="$(npm root --global)/openclaw" \
    && /usr/local/bin/verify-tencentdb-openclaw-patch.sh \
        "$OPENCLAW_ROOT" \
        /opt/openclaw-plugin-cache/openclaw-after-tool-call-messages.patch.sh

ENV TENCENTDB_PLUGIN_VERSION=${TENCENTDB_PLUGIN_VERSION} \
    OPENCLAW_MEMORY_TENCENTDB_ARCHIVE=/opt/openclaw-plugin-cache/memory-tencentdb.tgz \
    OFFICECLI_SKIP_UPDATE=1 \
    OFFICECLI_NO_AUTO_RESIDENT=1

USER node
ENTRYPOINT ["tini", "-s", "--", "/usr/local/bin/bootstrap-officecli.sh"]
CMD ["/usr/local/bin/validate-gogcli.sh", "openclaw", "gateway"]
