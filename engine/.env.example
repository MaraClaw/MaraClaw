# === Core / App =================================================================

# Application name displayed in UI and OpenAPI docs; also the OpenRouter X-OpenRouter-Title attribution
# for engine LLM calls and guest memory embeddings (guest chat stays "OpenClaw", see llm/AGENTS.md).
APP_NAME=MaraClaw

# Optional: override app version.  Default: read from VERSION file at startup.
APP_VERSION=1.1.8

# Enable verbose logging and stack traces on 500 errors.
DEBUG=false

# Process logger (app.core.logging). LOG_LEVEL defaults to DEBUG when DEBUG=true.
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# LOG_QUEUE_SIZE=8192
# LOG_COLOR=true

# Prometheus text metrics at GET /api/metrics: route latency by route template and status, database pool size,
# available connections and waiting requests, event-loop lag and dropped log records. The route exists only while
# METRICS_TOKEN is set (empty: 404); scrapers send "Authorization: Bearer <token>". Use a long random value.
# EVENT_LOOP_LAG_INTERVAL_SECONDS is the gap between lag samples (0.1 to 60).
# METRICS_TOKEN=
# EVENT_LOOP_LAG_INTERVAL_SECONDS=1

# REQUIRED in production: random secret for session cookies / internal signing.
# Default value is INSECURE and will warn on startup if not changed.
SECRET_KEY=change-me-in-production

# Optional: prefix for all API routes (default: /api).  Change only if you front
# the backend at a different path.
# API_PREFIX=/api

# REQUIRED: PostgreSQL connection string.  Replace credentials with real ones.
# Use a native PostgreSQL URL with sslmode for TLS; driver-qualified schemes and ssl are rejected.
# TLS example: postgresql://user:pass@host:5432/db?sslmode=require
# Default (local dev): postgresql://localhost:5432/maraclaw
DATABASE_URL=postgresql://localhost:5432/maraclaw

# Optional: psycopg AsyncConnectionPool sizing.
# DATABASE_POOL_MIN_SIZE=2
# DATABASE_POOL_MAX_SIZE=30
# DATABASE_POOL_TIMEOUT=30
# Optional: requests allowed to queue for a pooled connection before the next one gets a 503 (0 = unbounded).
# DATABASE_POOL_MAX_WAITING=60
# DATABASE_POOL_MAX_IDLE=600
# DATABASE_POOL_MAX_LIFETIME=1800
# Optional: server-side session limits on every pooled connection, in milliseconds (0 disables a limit).
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=60000
# Optional: lock wait of a short CRUD request (ms; 0 disables). Set per request at checkout, never on workers.
# DATABASE_REQUEST_LOCK_TIMEOUT_MS=5000
# Optional: size of the separate durable-commit pool (1-1000); independent of DATABASE_POOL_MAX_SIZE.
# DATABASE_DURABLE_POOL_MAX_SIZE=4
# Optional: Days to keep chat_history_changes journal rows; 0 keeps them forever.
# CHAT_HISTORY_RETENTION_DAYS=30
# Optional: largest chat submission text in characters (code points). A longer content, display_content or file_name
# is refused whole with a typed rejection (message_too_long, file_name_too_long); it is never truncated.
# CHAT_CONTENT_MAX_CHARS=200000
# CHAT_DISPLAY_CONTENT_MAX_CHARS=200000
# CHAT_FILE_NAME_MAX_CHARS=255
# Optional: chat sockets one user may hold at once, counted across every engine process from Redis presence. The
# extra socket is closed with 4029 after accept; a closed socket, or one whose process died, stops counting once its
# presence expires (180 s at most).
# CHAT_SOCKETS_PER_USER=20
# Optional: submissions one chat socket may send per window, counted in the memory of the process serving it. The
# submission over the budget gets a rate_limited rejection and the socket stays open.
# CHAT_SUBMISSIONS_PER_WINDOW=10
# CHAT_SUBMISSION_WINDOW_SECONDS=10
# The default START_COMMAND also starts uvicorn with --ws-max-size = 4 * (the three text limits above) + 64 KiB, so a
# frame over that closes with 1009 before it is parsed. A START_COMMAND you set yourself keeps full control: add the
# same flag, with `python -m app.scripts.chat_frame_limit` printing the value, or oversized frames reach the handler.
# Optional: Days to keep agent_activity_logs rows (the agent activity timeline), counted from created_at.
# Default 0 keeps them forever; set it to let old rows age out in bounded batches.
# ACTIVITY_LOG_RETENTION_DAYS=0
# Optional: Days to keep completed and failed trigger_executions rows (trigger run history), counted from
# finished_at. Default 0 keeps them forever. Pending and processing executions are never deleted. Deleting a
# finished execution frees its idempotency key so a late webhook redelivery could run again; because of that
# any nonzero value below 7 is rejected at startup.
# TRIGGER_EXECUTION_RETENTION_DAYS=0
# Optional: Days to keep the content and result of completed gateway_messages (agent gateway history), counted from
# completed_at. Default 0 keeps them forever. Older rows stay with an empty content and no result, so delayed-reply
# recovery still recognizes them; a message whose report is still being relayed keeps its result. Any nonzero value
# below 7 is rejected at startup.
# GATEWAY_MESSAGE_RETENTION_DAYS=0
# Optional: Days to keep notifications, counted from created_at. Default 0 keeps them forever.
# NOTIFICATION_RETENTION_DAYS=0
# Optional: Days to keep tasks that are done, together with their logs, counted from completed_at (updated_at when
# the task was marked done without one). Default 0 keeps them forever. Tasks that are not done are never deleted.
# TASK_RETENTION_DAYS=0
# Optional: Days to keep channel_event_receipts (the provider event dedup records), counted from created_at. Default
# 0 keeps them forever. Deleting a receipt also deletes its media descriptors and burst outcomes (ON DELETE
# CASCADE), and a provider retry that arrives after that runs again, so any nonzero value below 7 is rejected at
# startup.
# CHANNEL_EVENT_RECEIPT_RETENTION_DAYS=0
# Optional: Days to keep gateway_report_deliveries that were delivered or ended terminal, counted from delivered_at
# or terminal_at. Default 0 keeps them forever. A delivery that is still pending is never deleted; the gateway
# message rows stay.
# GATEWAY_REPORT_DELIVERY_RETENTION_DAYS=0
# Optional: Days to keep workspace_file_revisions that a newer revision of the same file has replaced, counted from
# created_at. Default 0 keeps them forever. The newest revision of each file is never deleted.
# WORKSPACE_REVISION_RETENTION_DAYS=0

# Optional: Redis URL. Default (local dev): redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Optional: overrides the auto-generated instance ID (hostname-pid-random).
# Default: auto-generated per-process.  Set explicitly only for multi-process
# deployments where you need stable IDs (e.g. multiple workers).
# INSTANCE_ID=api-hostname-1234-abcdef01


# === JWT / Auth =================================================================

# REQUIRED in production: random secret for signing JWT access tokens.
# Default value is INSECURE and will warn on startup if not changed.
JWT_SECRET_KEY=change-me-jwt-secret

# JWT algorithm for access token signing.  Default: HS256.
JWT_ALGORITHM=HS256

# Access token expiry in minutes.  Default: 1440 (24 hours).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Password reset token expiry in minutes.  Default: 60.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Email verification token expiry in minutes.  Default: 60.
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=60

# Require email verification before allowing login.  Default: false.
EMAIL_VERIFICATION_REQUIRED=false

# Public auth throttling (Redis fixed windows, checked before any password check or email send; a Redis error allows
# the request). A refused request gets 429 with Retry-After.
# Window length in seconds.  Default: 300.
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# Attempts per window for one account, counted separately for login, forgot-password and resend-verification.
# Default: 10.
AUTH_RATE_LIMIT_ACCOUNT_ATTEMPTS=10
# Attempts per window for one client address. Keep it high enough for an office behind one NAT address.  Default: 300.
AUTH_RATE_LIMIT_ADDRESS_ATTEMPTS=300
# Chat and download ticket requests per window for one signed-in user.  Default: 60.
TICKET_RATE_LIMIT_USER_ATTEMPTS=60
# Password checks admitted at once (running on the four bcrypt threads plus queued). A check that cannot be
# admitted is refused with 503 and Retry-After.  Default: 32.
BCRYPT_MAX_PENDING_CHECKS=32

# Peers whose X-Forwarded-For is believed when resolving the client address, as a JSON list of IPs or CIDRs.
# Set it to the reverse proxy's address or network (for example the Docker network Caddy sits on); the address
# limits above, the admission submit limit and audit trails then use the real client. Empty trusts no header, so
# every user behind the proxy shares the proxy's address.  Default: [].
TRUSTED_PROXIES='[]'

# Genesis platform admin (seeded at bootstrap). Required for a fresh install.
# The seeded account must change password after the first successful login.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-on-first-login

# KABERs organization genesis admin: required when the account is missing.
# The seeded account must change password after first login; restarts do not rotate it.
KABERS_ORG_ADMIN_EMAIL=
KABERS_ORG_ADMIN_PASSWORD=

# Redis TTL (seconds) for check_agent_access decisions. 0 disables Redis caching.
# AGENT_ACCESS_CACHE_TTL_SECONDS=45
# Redis TTL (seconds) for soul/memory/skill prompt fragments. 0 disables.
# AGENT_CONTEXT_CACHE_TTL_SECONDS=60
# Redis TTL for authenticated user+identity snapshots (no password_hash). 0 disables.
# USER_SESSION_CACHE_TTL_SECONDS=20
# Redis TTL for tenant rows (catalog / timezone). 0 disables.
# TENANT_CACHE_TTL_SECONDS=60
# Redis TTL for inbound channel event dedup. 0 uses process-local only.
# CHANNEL_DEDUP_TTL_SECONDS=86400
# Attachments fetched from one native channel message, 1 to 10. Later ones are skipped with a notice in the message.
# CHANNEL_MEDIA_MAX_ATTACHMENTS=10
# Seconds a Slack, Telegram or WhatsApp Cloud webhook may spend starting fetches and stores for attachments before it
# answers, above 0 up to 30. Files not fetched or not stored in time are skipped with a notice in the message; a store
# already started finishes, so the answer can overrun by one store. Slack gives up after 3 seconds.
# CHANNEL_MEDIA_ACK_BUDGET_SECONDS=2
# Optional: Gateway report relay limits. A delivery whose attempt fails is marked failed (with a reason) once it has
# been attempted GATEWAY_REPORT_MAX_ATTEMPTS times or is GATEWAY_REPORT_MAX_AGE_HOURS hours old; permanent provider
# errors such as Slack channel_not_found fail on the first attempt. One tenant takes at most
# GATEWAY_REPORT_TENANT_CLAIM_LIMIT rows into a single claim batch (the relay runs 20 deliveries at a time).
# GATEWAY_REPORT_MAX_ATTEMPTS=30
# GATEWAY_REPORT_MAX_AGE_HOURS=24
# GATEWAY_REPORT_TENANT_CLAIM_LIMIT=5
# 0 disables shared Feishu/WeCom/DingTalk token cache.
# IM_TOKEN_CACHE_TTL_SECONDS=1
# REDIS_KEY_PREFIX=mrc
# One process opens at most REDIS_MAX_CONNECTIONS + REDIS_CACHE_MAX_CONNECTIONS + REDIS_PUBSUB_MAX_CONNECTIONS
# connections; keep that sum times the process count under the Redis/Valkey connection limit.
# REDIS_MAX_CONNECTIONS=50
# Seconds a command waits for a free durable-pool connection before failing as pool overload; below REDIS_SOCKET_TIMEOUT.
# REDIS_COMMAND_WAIT_SECONDS=1
# Dedicated pool of the realtime and gateway-report-wake subscribers; at least 4 (twice the long-lived subscribers).
# REDIS_PUBSUB_MAX_CONNECTIONS=4
# REDIS_CACHE_MAX_CONNECTIONS=20
# REDIS_SOCKET_TIMEOUT=5
# REDIS_CACHE_SOCKET_TIMEOUT=0.2
# Seconds the cache pool waits to connect; at most REDIS_CACHE_SOCKET_TIMEOUT, so a down cache costs one read budget.
# REDIS_CACHE_CONNECT_TIMEOUT=0.2


# === File Storage =================================================================

# Storage backend: "local" or "s3".  Default: local.
STORAGE_BACKEND=local

# REQUIRED when STORAGE_BACKEND=s3: S3 bucket name.
# S3_BUCKET=maraclaw-agents

# Optional: S3 region.  Default: empty (uses AWS default region).
# S3_REGION=us-east-1

# Optional: S3-compatible endpoint URL (for MinIO / self-hosted S3).
# S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com

# Optional: AWS access key ID for S3.  Default: empty (uses IAM role / env creds).
# S3_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX

# Optional: AWS secret access key for S3.  Default: empty (uses IAM role / env creds).
# S3_SECRET_ACCESS_KEY=your-secret-key-here

# S3 key prefix for agent data.  Default: agents.
S3_PREFIX=agents

# Presigned URL TTL in seconds.  Default: 3600.
S3_PRESIGN_TTL_SECONDS=3600

# Max HTTP connections in S3 connection pool.  Default: 50.
S3_MAX_POOL_CONNECTIONS=50

# Threads in the storage lane that runs blocking S3 calls (reads, lists, writes, presigning), kept apart from the
# default executor.  Never more than S3_MAX_POOL_CONNECTIONS.  Default: 32.
S3_THREAD_LANE_SIZE=32

# Largest file, in bytes, the web editor, the text and CSV previews and the enterprise knowledge base content read take
# into memory, and the most text a single save may carry.  A larger file answers 413 file_too_large and is offered as a
# download; it is never cut off.  Revision history stores text only up to 512 KiB, whatever this is.
# Default: 1048576 (1 MiB).
WORKSPACE_FILE_CONTENT_MAX_BYTES=1048576

# Threads of the document conversion lane: openpyxl, python-docx, WeasyPrint and large file reads of the convert_* tools
# run there, apart from the event loop and the default executor.  Default: 4.
DOCUMENT_CONVERSION_LANE_THREADS=4

# Seconds one convert_* call may take, waiting for a lane thread included.  Past it the call returns an error; a
# running conversion cannot be interrupted and keeps its lane thread until it ends.  Default: 120.
DOCUMENT_CONVERSION_TIMEOUT_SECONDS=120

# Chrome processes that HTML-to-PDF and slide rendering may run at once, shared by both (see Browser / Chromium below).
# A render that cannot get one within 30 s falls back to WeasyPrint (PDF) or the DOM conversion (PPTX).  Default: 2.
DOCUMENT_CHROME_MAX_CONCURRENCY=2


# === Feishu / Lark OAuth ==========================================================

# Optional: Feishu (Lark) app credentials for OAuth SSO and message channels.
# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxxx
# FEISHU_APP_SECRET=your-feishu-app-secret-here

# Optional: OAuth redirect URI configured in Feishu app settings.
# FEISHU_REDIRECT_URI=https://your-domain.com/api/auth/feishu/callback

# Deployment-owned public URL for webhook URLs, OAuth callbacks, invitations and published pages.
# Loaded through Settings from environment or .env; never inferred from request hosts.
# If unset, absolute-URL endpoints return 503 and published pages use relative links.
# Reset/verify emails prefer an allowlisted Origin/Referer (CORS_ORIGINS), otherwise use this URL.
# With neither source, mail is skipped; registration succeeds and forgot-password stays generic.
# PUBLIC_BASE_URL=https://your-domain.com

# ChatGPT (Plus / Pro / Team) browser sign-in. Empty CHATGPT_OAUTH_REDIRECT_URI (the default) disables it:
# the start endpoint answers 503 and no callback route is registered.
# Otherwise it must be <public origin of this engine> + the callback path, reachable from the admin's
# browser, and exactly match a redirect URI registered for CHATGPT_OAUTH_CLIENT_ID. The engine serves GET on
# that path itself (no /api prefix, no login: the provider redirects there with a single-use state), so pick a
# path no other route uses and forward it through any proxy in front of the engine. Read at startup; restart
# after changing it. The path may not be "/".
# CHATGPT_OAUTH_REDIRECT_URI=https://engine.example.com/auth/chatgpt/callback
# OAuth client for sign-in, code exchange, refresh and guest auth profiles. The default is the public Codex
# client, which accepts only the Codex CLI's own localhost redirect; any other redirect URI needs an OAuth
# client you control with that URI registered.
# CHATGPT_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann

# Optional: HTTP(S) proxy for trusted server-side outbound clients
# (Feishu/Lark, Google Workspace OAuth, etc.).  Default: empty.
# These do NOT automatically inject into code-execution sandboxes -
# use SANDBOX_*_PROXY below for that.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=


# === CORS ========================================================================

# Allowed CORS origins as a JSON array of URLs (pydantic-settings parses lists as JSON).
# Wrap the value in SINGLE QUOTES so bash sourcing preserves the inner double quotes.
# In production, set to your frontend domain(s).  "*" not allowed with credentials.
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]'


# === LLM Providers / web access ==================================================

# Provider health (per worker process, in memory). A model whose calls fail this many times in a row with a
# retryable error (429, 5xx, timeouts, dropped connections) stops receiving new turns: agents with a fallback model
# answer from it, others get a fast error. After the cooldown one probe request is let through; its success closes the
# circuit and its failure reopens it. Other 4xx answers (bad request, auth) never count.
# LLM_PROVIDER_FAILURE_THRESHOLD=5
# LLM_PROVIDER_COOLDOWN_SECONDS=30

# Optional: Tavily API key. Seeds the DB key ring when empty.
# Provider keys stay server-side; guests receive only agent-scoped proxy tokens.
# Get a key at https://app.tavily.com
# TAVILY_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: xAI key for Search X (`search_x`) and Grok Imagine (`generate_image_grok`)
# when the tool config api_key is empty. Get a key at https://console.x.ai
# XAI_API_KEY=
# TAVILY_PROXY_ENABLED=true
# Optional guest-reachable proxy base override. When empty, defaults to
# OPENCLAW_ENGINE_BASE_URL + /api/tavily (http://maraclaw-engine:8000/api/tavily by default). If using Docker: http://host.docker.internal:8000/api/tavily
# TAVILY_PROXY_BASE_URL=
# Proxy bounds per call. A request body over TAVILY_PROXY_MAX_REQUEST_BYTES gets 413 (chunked uploads included)
# before any key is chosen. A decoded upstream response over TAVILY_PROXY_MAX_RESPONSE_BYTES is aborted with 502.
# TAVILY_PROXY_DEADLINE_SECONDS is one monotonic budget for key rotation, the transient retry, the
# TAVILY_API_KEY fallback and bound job polls together; when it runs out the call gets 504.
# TAVILY_PROXY_MAX_REQUEST_BYTES=1048576
# TAVILY_PROXY_MAX_RESPONSE_BYTES=10485760
# TAVILY_PROXY_DEADLINE_SECONDS=120

# Search analytics: capture billed Tavily POSTs to Postgres. Export is off until a bucket is set.
# WEB_SEARCH_ANALYTICS_CAPTURE_ENABLED=true
# WEB_SEARCH_ANALYTICS_EXPORT_ENABLED=false
# WEB_SEARCH_ANALYTICS_INCLUDE_RAW=false
# WEB_SEARCH_ANALYTICS_RETENTION_DAYS=90
# WEB_SEARCH_ANALYTICS_HASH_KEY=
# ANALYTICS_S3_BUCKET=
# ANALYTICS_S3_PREFIX=web-search/


# === Sandbox / Code Execution =====================================================

# Sandbox backend type. Allowed values (lowercase, matches enum values):
#   subprocess | docker | e2b | judge0 | codesandbox | self_hosted | aio_sandbox
# Default: subprocess (local bubblewrap-based execution).
SANDBOX_TYPE=subprocess

# Optional: Remote sandbox API key (for E2B, Judge0, CodeSandbox, Self-Hosted).
# SANDBOX_API_KEY=your-sandbox-api-key

# Optional: Remote sandbox API URL (for SELF_HOSTED backend).
# SANDBOX_API_URL=https://your-sandbox-api.example.com

# CPU limit for local sandbox (fraction of a core).  Default: 0.5.
SANDBOX_CPU_LIMIT=0.5

# Memory limit for local sandbox (e.g. "256m", "1g").  Default: 256m.
SANDBOX_MEMORY_LIMIT=256m

# Allow outbound network from sandbox.  Default: false.
SANDBOX_ALLOW_NETWORK=false

# Allow local source runs to fall back to reduced-isolation mode when bwrap
# is missing.  Default: true on host (source), false in containers.
# Set false (or leave unset) in Docker/production - the image ships setuid
# bwrap for isolation and unsafe fallback must stay fail-closed there.
SANDBOX_ALLOW_UNSAFE_FALLBACK_WHEN_BWRAP_MISSING=true

# Default execution timeout in seconds.  Default: 30.
SANDBOX_DEFAULT_TIMEOUT=30

# Maximum execution timeout in seconds.  Default: 60.
SANDBOX_MAX_TIMEOUT=60

# Optional: proxy env injected into sandbox guests (subprocess/docker).
# Only applied when SANDBOX_ALLOW_NETWORK=true; config-only (no host env inherit).
# Explicit SANDBOX_* only - global HTTP_PROXY is never reused for sandboxes.
# SANDBOX_HTTP_PROXY=
# SANDBOX_HTTPS_PROXY=
# SANDBOX_NO_PROXY=

# Optional: Maximum execute_code runs at once across all agents.
# SANDBOX_MAX_CONCURRENT_EXECUTIONS=8
# Optional: Seconds an execute_code call may wait for a free slot before it is refused.
# SANDBOX_EXECUTION_QUEUE_WAIT_SECONDS=10


# === Docker / Agent Containers ====================================================

# Docker network for openclaw agent containers.  Default: maraclaw_network.
DOCKER_NETWORK=maraclaw_network

# OpenClaw container image.  Default: openclaw:2026.11.3.
# Bare non-digest references are local-only; build on the worker's Docker daemon before upgrading.
# Namespaced/registry and digest-pinned references are freshly pulled during upgrades.
# Build or publish the image from the guest image project; see its README. For local
# builds, match this tag and use the worker's Docker daemon.
MARACLAW_OPENCLAW_IMAGE=arm64-openclaw:2026.11.3

# Gateway port for openclaw agent communication.  Default: 18789.
OPENCLAW_GATEWAY_PORT=18789

# Concurrent conversation lanes per agent (1 restores serial turns; range 1-16).
OPENCLAW_AGENT_MAX_PARALLEL_TURNS=4

# Native turns per worker process, on dedicated threads (range 1-256).
# May be lower than the per-agent limit; waiting lanes remain unclaimed.
OPENCLAW_PROCESS_MAX_PARALLEL_TURNS=16

# Scheduled executions one worker runs at once (periodic and manual runs share it; range 1-256).
# A worker leases only as many due schedules as it has free slots; peers pick up the rest.
SCHEDULE_MAX_CONCURRENT_EXECUTIONS=8

# Trigger invocations one worker runs at once (claimed triggers and agent-to-agent wakes share it; range 1-256).
# A worker claims ready trigger work for at most as many agents as it has free slots; peers pick up the rest.
TRIGGER_MAX_CONCURRENT_INVOCATIONS=8

# Wall-clock budget in seconds of one background run (greater than 0, at most 86400). When it runs out the run stops at
# its next guarded checkpoint and is recorded as timed out: a failed schedule_run for a periodic schedule, failed
# executions for a trigger invocation, and a logged timeout for a heartbeat. The lease and capacity slot are kept until
# that outcome is written.
SCHEDULE_RUN_BUDGET_SECONDS=1800
TRIGGER_RUN_BUDGET_SECONDS=1800
HEARTBEAT_RUN_BUDGET_SECONDS=900

# Per-guest trial limits for system agents and agents with no organization; every organization's agents use their
# tier's limits (see docs/guest-containers.md). Applied when a guest is created or a stopped guest is resumed, never to
# a running guest. All limits must be greater than zero.
# Memory limit in bytes (2147483648 bytes = 2 GiB).
OPENCLAW_GUEST_MEMORY_LIMIT_BYTES=2147483648
# CPU allocation in cores; fractional values are supported.
OPENCLAW_GUEST_CPUS=1.0
# Maximum number of processes per guest.
OPENCLAW_GUEST_PIDS_LIMIT=512
# Optional OpenClaw experiments (None/unset): no new values on fresh configs.
# Unset thinking/bootstrap settings preserve guest customizations; to reset, also remove the guest field.
# Explicit values override guest defaults. See docs/guest-containers.md for ownership and trade-offs.
# OPENCLAW_THINKING_DEFAULT=low
# OPENCLAW_ANTHROPIC_CACHE_RETENTION=long
# OPENCLAW_BOOTSTRAP_MAX_CHARS=20000
# OPENCLAW_BOOTSTRAP_TOTAL_MAX_CHARS=60000
# Optional aggregate hard-memory budget for running/restarting guests on DOCKER_NETWORK.
# 0 disables admission; otherwise at least the larger of OPENCLAW_GUEST_MEMORY_LIMIT_BYTES and the Ultra tier's
# 5368709120 bytes (5 GiB), so one guest of any tier fits. Admission reserves the guest's target memory (its tier's,
# or the setting above). No host-derived default.
OPENCLAW_GUEST_AGGREGATE_MEMORY_LIMIT_BYTES=0
# Deadline in seconds for each Docker CLI launch that manages guests (inspect, list, run, stop, remove).
# An expired launch is killed and reported as a Docker failure; the daemon may still finish the request.
# 0 leaves launches unbounded; range 0-3600. Long gateway turns and image pulls keep their own deadlines.
OPENCLAW_DOCKER_CLI_TIMEOUT_SECONDS=120
# Docker CLI calls the engine runs at once on one event loop (range 1-256), and how many calls of each priority
# (interactive start and stop; background sweeps) may wait for a thread (range 0-100000). A full queue refuses the next
# call: HTTP routes answer 503 with Retry-After, and background loops skip that pass. Raising the thread count only
# moves the queue into the Docker daemon.
DOCKER_LANE_THREADS=16
DOCKER_LANE_QUEUE_LIMIT=256
# Deadline in seconds for pulling a registry or digest-pinned guest image, on ordinary starts and upgrades.
# Range above 0 up to 86400. Bare local image names are never pulled.
OPENCLAW_GUEST_IMAGE_PULL_TIMEOUT_SECONDS=1800
# Log rotation for newly created guests: the largest log file (a number with an optional k, m or g) and how many files
# are kept. Passed only when the Docker daemon's default logging driver is json-file or local; under any other driver
# (journald, awslogs, ...) or when the driver cannot be read, no size options are set. Existing guests are not recreated.
OPENCLAW_GUEST_LOG_MAX_SIZE=10m
OPENCLAW_GUEST_LOG_MAX_FILE=3
# Seconds between passes of the worker that measures each tier-governed agent's workspace disk usage (host directory
# plus guest writable layer). An agent over its tier allowance refuses new messages until a later measurement (a pass,
# or a file delete) finds it back under. Range 30-86400.
AGENT_WORKSPACE_QUOTA_INTERVAL_SECONDS=600
# Agents that worker measures at once; each in-flight measurement holds one directory-walk thread and may run one Docker
# layer read (background priority), so this bounds both. A pass takes about agents / this number of walks. Range 1-32.
AGENT_WORKSPACE_QUOTA_CONCURRENCY=4
# With STORAGE_BACKEND=s3, a worker mirrors each guest's user files (workspace/, memory/, daily_reports/, skills/,
# media/outbound/ and the root AGENTS.md, HEARTBEAT.md, soul.md, state.json) with the agent's managed storage both
# ways, so mirrored files count against the storage quota. Local storage is the guest directory itself, so the mirror
# is idle there. INTERVAL range 10-3600 seconds.
WORKSPACE_MIRROR_ENABLED=true
WORKSPACE_MIRROR_INTERVAL_SECONDS=60
# Agents the workspace mirror worker mirrors at once, never two of the same organization; each in-flight agent holds
# one transfer buffer, so this bounds the mirror's memory. Range 1-32.
WORKSPACE_MIRROR_CONCURRENCY=4
# Lifetime in seconds of a share link a guest mints for one workspace file (POST /api/gateway/file-links), so tools
# outside the container such as remote MCP servers can download it. Range 60-86400.
FILE_SHARE_LINK_TTL_SECONDS=900
# Seconds between passes of the worker that samples each tier-governed agent's guest memory, CPU and managed storage
# (the workspace pass above reports disk) and records an episode while a resource stays at or above THRESHOLD of its
# limit; platform admins read them under /api/admin/resource-pressure. INTERVAL range 30-86400; THRESHOLD above 0, at
# most 1.
AGENT_RESOURCE_PRESSURE_INTERVAL_SECONDS=300
AGENT_RESOURCE_PRESSURE_THRESHOLD=0.9
# Seconds between passes of the worker that expires capacity orders left unpaid past their month and, from the
# first pass of a Vietnam calendar month, creates each company's renewal of its paid extra accounts and agents (one
# per company and month, idempotent; skipped with a warning until the genesis platform admin saves the bank details
# and USD/VND rate). Range 30-86400.
CAPACITY_RENEWAL_INTERVAL_SECONDS=3600

# Personal WhatsApp (QR) burst batching. Self-chat originals are each accepted, charged and stored, then join
# ONE guest turn after QUIET seconds without a new original, at most MAX seconds after the first. All values
# must be positive and finite; QUIET <= MAX and BODY_BYTES <= PENDING_BYTES. Pending limits count waiting
# originals / raw UTF-8 bytes (excluding the one in-flight batch). BODY_BYTES bounds one joined batch (two newlines
# between originals count); a single original larger than it is rejected with a static "not queued" notice,
# never truncated. Notices are limited to one per conversation scope per cooldown.
# Defaults: 2, 5, 50, 65536, 16384, 30.
WHATSAPP_PERSONAL_BURST_QUIET_SECONDS=2
WHATSAPP_PERSONAL_BURST_MAX_SECONDS=5
WHATSAPP_PERSONAL_BURST_PENDING_COUNT=50
WHATSAPP_PERSONAL_BURST_PENDING_BYTES=65536
WHATSAPP_PERSONAL_BURST_BODY_BYTES=16384
WHATSAPP_PERSONAL_BUSY_NOTICE_COOLDOWN_SECONDS=30
# Personal WhatsApp bridge fleet. MAX_RUNNING_CHILDREN (1-5000) is a fleet-wide ceiling on the Node bridges running
# at once across every engine process, not per replica: a claim counts the unexpired 30 s leases in the database and is
# refused at the ceiling, and a dead process stops counting once its leases expire. MAX_STARTS_PER_POLL (1-100) caps how
# many waiting connections each engine process starts on each one-second supervisor poll, longest waiting first, so a
# restart returns the fleet in paced waves. WORKER_HEAP_MB (64-8192) is the V8 old-generation ceiling in MiB each
# bridge gives its Baileys worker: a session that outgrows it ends only its own bridge, which restarts through the
# durable retry budget (5, 15, 30, 60, 120 s) with credentials kept.
# Defaults: 200, 5, 512.
WHATSAPP_PERSONAL_MAX_RUNNING_CHILDREN=200
WHATSAPP_PERSONAL_MAX_STARTS_PER_POLL=5
WHATSAPP_PERSONAL_WORKER_HEAP_MB=512

# Optional Personal Zalo typing pulses for authorized, bound private peers with recent active reply work.
# At most 8 peers per pass, at least 5 seconds between pulses per peer while active. Default: false.
# The SDK has no stop-typing API; completing or revoking work only ends future pulses.
ZALO_PERSONAL_TYPING_ENABLED=false
# Operator-selected keepalive cadence in seconds, range 60-1800, default 300.
# The SDK server interval's units are undocumented; this value is explicit policy, not a unit conversion.
ZALO_PERSONAL_KEEPALIVE_INTERVAL_SECONDS=300
# Personal Zalo bridge fleet, with the same meaning, ranges and defaults as the WhatsApp fleet settings above:
# fleet-wide running ceiling (counting Zalo bridges only), starts per one-second poll per engine process (longest
# waiting first) and the SDK worker's V8 old-generation ceiling in MiB.
ZALO_PERSONAL_MAX_RUNNING_CHILDREN=200
ZALO_PERSONAL_MAX_STARTS_PER_POLL=5
ZALO_PERSONAL_WORKER_HEAP_MB=512
# Exact lowercase DNS hosts verified for provider attachment downloads; JSON list, maximum 32.
# Empty disables inbound media downloads. URLs, wildcards and IP literals are refused;
# each HTTPS redirect and resolved address is checked again before cookies or bytes are sent.
ZALO_PERSONAL_MEDIA_ALLOWED_HOSTS=[]

# Enable gogcli runtime wiring for opted-in local OpenClaw containers. Default: false.
# Per-agent keyring passwords are written through the gogcli keyring-secret API;
# do not put Google OAuth credentials or keyring passwords in this file.
GOGCLI_ENABLED=false

# Optional OpenAI-compatible embeddings for guest memory search. All four must be non-blank to
# take effect; if any is missing or blank, OpenClaw's own memory-search defaults apply.
# EMBEDDING_PROVIDER_URL is the API base URL; OpenClaw appends /embeddings to it.
# EMBEDDING_DIMS must be a positive integer.
# EMBEDDING_API_KEY is written in plaintext to each guest's bind-mounted openclaw.json
# (readable by anyone with access to the guest data directory); use a dedicated, least-privilege key.
# After the engine loads these settings, new/replacement guests use them. Existing guests
# gain them on the next config refresh; reusing or resuming a guest alone does not rewrite config.
# No guest restart is forced.
# EMBEDDING_MODEL=
# EMBEDDING_DIMS=
# EMBEDDING_PROVIDER_URL=
# EMBEDDING_API_KEY=

# === Process Role / Docker Entrypoint ============================================

# Roles for this backend instance: all, api, worker, connector, bootstrap.
# Multiple roles: comma-separated, e.g. "api,worker".  Default: all.
PROCESS_ROLE=all

# Allow alembic migration failure to be non-fatal.  Default: false.
ALLOW_MIGRATION_FAILURE=false

# Entrypoint start command (override the default uvicorn invocation).
# Default: uvicorn app.main:app --host 0.0.0.0 --port 8000
# The entrypoint runs it with `exec bash -c`. A custom command must run the server as its LAST
# command (or `exec` it), never piped or backgrounded, so the server itself receives SIGTERM.
# START_COMMAND=uvicorn app.main:app --host 0.0.0.0 --port 8000

# Graceful stop. On SIGTERM uvicorn lets in-flight HTTP requests finish for
# SHUTDOWN_HTTP_GRACE_SECONDS (exported as UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN unless that
# is already set), then the lifespan cleanup drains work and closes resources within
# SHUTDOWN_CLEANUP_BUDGET_SECONDS (at least 15 s, which stay reserved for closing resources).
# The container stop timeout (ECS stopTimeout, docker run --stop-timeout) must be at least
# grace + budget + 10 s; start-from-docker.sh passes exactly that. Fargate caps stopTimeout
# at 120 s, so settings may not sum past it.  Defaults: 30 + 75 + 10 = 115.
# SHUTDOWN_HTTP_GRACE_SECONDS=30
# SHUTDOWN_CLEANUP_BUDGET_SECONDS=75

# A crashed auth-email or broadcast-email loop is restarted with doubling delays (1 s up to the
# ceiling). The budget counts restarts over the process lifetime; once it is spent the next exit is
# final, readiness stays 503 and /api/live fails so the container is replaced. Default: 5 and 30.
# WORKER_LOOP_RESTART_BUDGET=5
# WORKER_LOOP_RESTART_MAX_BACKOFF_SECONDS=30


# === Proxy / Shadowsocks (Discord) ===============================================

# Optional: path to JSON config file with Shadowsocks proxy nodes for Discord.
# Default: /data/ss-nodes.json (inside Docker container).
# SS_CONFIG_FILE=/data/ss-nodes.json

# Optional: single Shadowsocks node via env vars (alternative to SS_CONFIG_FILE).
# Both SS_SERVER and SS_PASSWORD required to activate env-based node.
# SS_SERVER=10.0.0.1
# SS_PORT=1080
# SS_PASSWORD=your-ss-password
# SS_METHOD=chacha20-ietf-poly1305

# Optional: override proxy for Discord API calls (set automatically by ss-local).
# Format: socks5h://host:port  (note: socks5h means DNS resolves on proxy side).
# DISCORD_PROXY=socks5h://127.0.0.1:1080

# Optional: generic HTTPS proxy picked up by Discord, Teams, Google Workspace.
# Format: http://host:port or socks5h://host:port.
# HTTPS_PROXY=http://127.0.0.1:1080


# === IM Integrations - Teams / Slack / WeChat / DingTalk / WeCom ================

# Optional: Microsoft Teams tenant ID for bot authentication.
# TEAMS_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: Atlassian API key for Rovo tools.  Read by tool_seeder at startup.
# ATLASSIAN_API_KEY=your-atlassian-api-key


# === ClawHub / Skill Marketplace =================================================

# ClawHub API base URL.  Default: https://clawhub.ai/api.
CLAWHUB_BASE=https://clawhub.ai/api

# ClawHub mirror base URL (for China region).  Default: https://cn.clawhub-mirror.com/api.
CLAWHUB_MIRROR_BASE=https://cn.clawhub-mirror.com/api


# === Browser / Chromium (for PDF/image rendering) ===============================

# Optional: path to Chrome/Chromium binary.  Auto-detected if not set.
# CHROME_BIN=/usr/bin/chromium


# === Docker Build Args (build-time only, not runtime) ============================
#
# These are used during `docker build`.  They are NOT read by the app at runtime.
# Set them with: docker build --build-arg APT_MIRROR=mirrors.ustc.edu.cn ...
#

# Optional: APT package mirror (e.g. mirrors.ustc.edu.cn for China).
# APT_MIRROR=

# Optional: pip index URL for build-time dependency install.
# MARACLAW_PIP_INDEX_URL=https://pypi.example.com/simple

# Optional: pip trusted-host for the custom index URL.
# MARACLAW_PIP_TRUSTED_HOST=pypi.example.com


# === Local Development / Runner Scripts ==========================================
#
# These are used by start-from-docker.sh.
# Not all are consumed by pydantic-settings - some are shell-script only.
#

# Optional: host port mapped to container 8000.  Default: 8000.
# PORT=8000

# Optional: Docker image name for start-from-docker.sh.  Default: maraclaw-engine:local.
# IMAGE_NAME=maraclaw-engine:local

# Optional: Docker container name.  Default: maraclaw-engine.
# CONTAINER_NAME=maraclaw-engine

# Optional: host data directory mounted at /data and at the same host path
# so agent containers can bind-mount workspace files.  Default: ./.docker-data.
# DATA_DIR=./.docker-data

# Optional: path to .env file for docker run --env-file.  Default: .env (if present).
# ENV_FILE=.env

# Optional: run container in detached mode.  Default: 0.
# DETACH=0

# Optional: always pull base Docker image before build.  Default: 0.
# PULL=0

# ─────────────────────────────────────────────────────────────
# AgentBay SDK (wuying-agentbay-sdk)
# Used as a fallback when no per-agent / global Tool.config api_key is set.
# Get the key from https://agentbay.console.aliyun.com/ → Service Management.
# ─────────────────────────────────────────────────────────────

# Optional fallback API key. Preferred path is Company Settings → Tools →
# AgentBay: Browser Navigate, but this env var works if no DB row has a key.
# AGENTBAY_API_KEY=your-agentbay-api-key-here

# Optional: region for AgentBay cloud sessions. Defaults to the key's
# registered region (typically cn-shanghai).
# AGENTBAY_REGION_ID=cn-shanghai

# Optional: override the API gateway endpoint.
# Default: wuyingai.cn-shanghai.aliyuncs.com
# AGENTBAY_ENDPOINT=wuyingai.cn-shanghai.aliyuncs.com

# Optional: request timeout in milliseconds. Default: 60000.
# AGENTBAY_TIMEOUT_MS=60000

# Optional fallback for the cloud-desktop OS (computer_* tools). DB tool config
# wins; this env var fills in when no os_type is stored. One of: linux, windows.
# Default: linux.
AGENTBAY_OS_TYPE=linux
