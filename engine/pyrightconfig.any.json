{
  "include": ["app"],
  "extraPaths": ["."],
  "extends": "pyrightconfig.json",
  "typeCheckingMode": "standard",
  "pythonVersion": "3.14",
  "venvPath": ".",
  "venv": ".venv",
  "reportAny": "error",
  "reportExplicitAny": "warning",
  "exclude": [
    "**/skill_creator_files/**",
    "**/clawsec_skill_files/**",
    "**/gogcli_skill_files/**",
    "**/__pycache__/**",
    ".venv/**"
  ]
}
