# === Core / App =================================================================

# Application name displayed in UI and OpenAPI docs.
APP_NAME=MaraClaw

# Optional: override app version.  Default: read from VERSION file at startup.
APP_VERSION=2.1.1

# Enable verbose logging and stack traces on 500 errors.
DEBUG=false

# Process logger (app.core.logging). LOG_LEVEL defaults to DEBUG when DEBUG=true.
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# LOG_QUEUE_SIZE=8192
# LOG_COLOR=true

# REQUIRED in production: random secret for session cookies / internal signing.
# Default value is INSECURE and will warn on startup if not changed.
SECRET_KEY=change-me-in-production

# Optional: prefix for all API routes (default: /api).  Change only if you front
# the backend at a different path.
# API_PREFIX=/api

# REQUIRED: PostgreSQL connection string.  Replace credentials with real ones.
# SQLAlchemy runtime still accepts postgresql+asyncpg:// during migration.
# The new psycopg layer normalizes +asyncpg/+psycopg drivers and ssl=require → sslmode.
# Preferred long-term: postgresql://user:pass@host:5432/db?sslmode=require
# Default (local dev): postgresql+asyncpg://localhost:5432/maraclaw
DATABASE_URL=postgresql+asyncpg://localhost:5432/maraclaw

# Optional: psycopg AsyncConnectionPool sizing for the new data layer.
# DATABASE_POOL_MIN_SIZE=2
# DATABASE_POOL_MAX_SIZE=30
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_MAX_IDLE=600
# DATABASE_POOL_MAX_LIFETIME=1800

# Optional: Redis URL. Default (local dev): redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Optional: overrides the auto-generated instance ID (hostname-pid-random).
# Default: auto-generated per-process.  Set explicitly only for multi-process
# deployments where you need stable IDs (e.g. multiple workers).
# INSTANCE_ID=api-hostname-1234-abcdef01


# === JWT / Auth =================================================================

# REQUIRED in production: random secret for signing JWT access tokens.
# Default value is INSECURE and will warn on startup if not changed.
JWT_SECRET_KEY=change-me-jwt-secret

# JWT algorithm for access token signing.  Default: HS256.
JWT_ALGORITHM=HS256

# Access token expiry in minutes.  Default: 1440 (24 hours).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Password reset token expiry in minutes.  Default: 60.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Email verification token expiry in minutes.  Default: 60.
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=60

# Require email verification before allowing login.  Default: false.
EMAIL_VERIFICATION_REQUIRED=false

# Genesis platform admin (seeded at bootstrap). Required for a fresh install.
# The seeded account must change password after the first successful login.
# PLATFORM_ADMIN_EMAIL=admin@example.com
# PLATFORM_ADMIN_PASSWORD=change-me-on-first-login

# Redis TTL (seconds) for check_agent_access decisions. 0 disables Redis caching.
# AGENT_ACCESS_CACHE_TTL_SECONDS=45
# Redis TTL (seconds) for soul/memory/skill prompt fragments. 0 disables.
# AGENT_CONTEXT_CACHE_TTL_SECONDS=60
# Redis TTL for authenticated user+identity snapshots (no password_hash). 0 disables.
# USER_SESSION_CACHE_TTL_SECONDS=20
# Redis TTL for tenant rows (catalog / timezone). 0 disables.
# TENANT_CACHE_TTL_SECONDS=60
# Redis TTL for inbound channel event dedup. 0 uses process-local only.
# CHANNEL_DEDUP_TTL_SECONDS=86400
# 0 disables shared Feishu/WeCom/DingTalk token cache.
# IM_TOKEN_CACHE_TTL_SECONDS=1


# === File Storage =================================================================

# Storage backend: "local" or "s3".  Default: local.
STORAGE_BACKEND=local

# REQUIRED when STORAGE_BACKEND=s3: S3 bucket name.
# S3_BUCKET=maraclaw-agents

# Optional: S3 region.  Default: empty (uses AWS default region).
# S3_REGION=us-east-1

# Optional: S3-compatible endpoint URL (for MinIO / self-hosted S3).
# S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com

# Optional: AWS access key ID for S3.  Default: empty (uses IAM role / env creds).
# S3_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX

# Optional: AWS secret access key for S3.  Default: empty (uses IAM role / env creds).
# S3_SECRET_ACCESS_KEY=your-secret-key-here

# S3 key prefix for agent data.  Default: agents.
S3_PREFIX=agents

# Presigned URL TTL in seconds.  Default: 3600.
S3_PRESIGN_TTL_SECONDS=3600

# Max HTTP connections in S3 connection pool.  Default: 50.
S3_MAX_POOL_CONNECTIONS=50

# Number of async workers for S3 write operations.  Default: 32.
S3_WRITE_WORKERS=32


# === Feishu / Lark OAuth ==========================================================

# Optional: Feishu (Lark) app credentials for OAuth SSO and message channels.
# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxxx
# FEISHU_APP_SECRET=your-feishu-app-secret-here

# Optional: OAuth redirect URI configured in Feishu app settings.
# FEISHU_REDIRECT_URI=https://your-domain.com/api/auth/feishu/callback

# Optional: fallback public URL for member email links (reset / verify) when the
# request has no allowlisted Origin. web-l is the member site; web-a reset emails
# use the admin Origin (CORS_ORIGINS) when the operator requests a reset there.
# PUBLIC_BASE_URL=https://your-domain.com

# Optional: HTTP(S) proxy for trusted server-side outbound clients
# (Feishu/Lark, Google Workspace OAuth, etc.).  Default: empty.
# These do NOT automatically inject into code-execution sandboxes -
# use SANDBOX_*_PROXY below for that.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=


# === CORS ========================================================================

# Allowed CORS origins as a JSON array of URLs (pydantic-settings parses lists as JSON).
# Wrap the value in SINGLE QUOTES so bash sourcing preserves the inner double quotes.
# In production, set to your frontend domain(s).  "*" not allowed with credentials.
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]'


# === LLM Providers / web access ==================================================

# Optional: Linkup API key. Seeds the DB key ring when empty.
# After keys exist in the database, guests call LINKUP_PROXY_BASE_URL instead of api.linkup.so.
# Get a key at https://app.linkup.so
# LINKUP_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: xAI key for Search X (`search_x`) and Grok Imagine (`generate_image_grok`)
# when the tool config api_key is empty. Get a key at https://console.x.ai
# XAI_API_KEY=
# LINKUP_PROXY_ENABLED=true
# Local engine. Guest containers on the Docker network should use
# http://maraclaw-engine:8000/api/linkup instead.
LINKUP_PROXY_BASE_URL=http://localhost:8000/api/linkup

# Search analytics: capture billed Linkup POSTs to Postgres. Export is off until a bucket is set.
# WEB_SEARCH_ANALYTICS_CAPTURE_ENABLED=true
# WEB_SEARCH_ANALYTICS_EXPORT_ENABLED=false
# WEB_SEARCH_ANALYTICS_INCLUDE_RAW=false
# WEB_SEARCH_ANALYTICS_RETENTION_DAYS=90
# WEB_SEARCH_ANALYTICS_HASH_KEY=
# ANALYTICS_S3_BUCKET=
# ANALYTICS_S3_PREFIX=web-search/


# === Sandbox / Code Execution =====================================================

# Sandbox backend type. Allowed values (lowercase, matches enum values):
#   subprocess | docker | e2b | judge0 | codesandbox | self_hosted | aio_sandbox
# Default: subprocess (local bubblewrap-based execution).
SANDBOX_TYPE=subprocess

# Optional: Remote sandbox API key (for E2B, Judge0, CodeSandbox, Self-Hosted).
# SANDBOX_API_KEY=your-sandbox-api-key

# Optional: Remote sandbox API URL (for SELF_HOSTED backend).
# SANDBOX_API_URL=https://your-sandbox-api.example.com

# CPU limit for local sandbox (fraction of a core).  Default: 0.5.
SANDBOX_CPU_LIMIT=0.5

# Memory limit for local sandbox (e.g. "256m", "1g").  Default: 256m.
SANDBOX_MEMORY_LIMIT=256m

# Allow outbound network from sandbox.  Default: false.
SANDBOX_ALLOW_NETWORK=false

# Allow local source runs to fall back to reduced-isolation mode when bwrap
# is missing.  Default: true on host (source), false in containers.
# Set false (or leave unset) in Docker/production - the image ships setuid
# bwrap for isolation and unsafe fallback must stay fail-closed there.
SANDBOX_ALLOW_UNSAFE_FALLBACK_WHEN_BWRAP_MISSING=true

# Default execution timeout in seconds.  Default: 30.
SANDBOX_DEFAULT_TIMEOUT=30

# Maximum execution timeout in seconds.  Default: 60.
SANDBOX_MAX_TIMEOUT=60

# Optional: proxy env injected into sandbox guests (subprocess/docker).
# Only applied when SANDBOX_ALLOW_NETWORK=true; config-only (no host env inherit).
# Explicit SANDBOX_* only - global HTTP_PROXY is never reused for sandboxes.
# SANDBOX_HTTP_PROXY=
# SANDBOX_HTTPS_PROXY=
# SANDBOX_NO_PROXY=


# === Docker / Agent Containers ====================================================

# Docker network for openclaw agent containers.  Default: maraclaw_network.
DOCKER_NETWORK=maraclaw_network

# OpenClaw container image.  Default: openclaw:local.
# Build the local image with TencentDB Agent Memory prepacked:
#   ./build-openclaw-local-dockerfile.sh
OPENCLAW_IMAGE=openclaw:local

# Gateway port for openclaw agent communication.  Default: 18789.
OPENCLAW_GATEWAY_PORT=18789

# Enable TencentDB Agent Memory as the default OpenClaw memory plugin.  Default: true.
# Guest bootstrap installs the plugin on first start. Engine only pins
# plugins.slots.memory after that install succeeds; a missing plugin makes
# openclaw.json invalid and the gateway will not start.
OPENCLAW_MEMORY_TENCENTDB_ENABLED=true

# Optional: TencentDB plugin version for openclaw agent containers.  Default: 1.0.1.
TENCENTDB_PLUGIN_VERSION=1.0.1

# Optional: OpenClaw version for agent containers.  Default: 2026.7.1-2.
OPENCLAW_VERSION=2026.7.1-2
OPENCLAW_SHA256=sha256:5bb525f36f471a41239615d321c441778c7e1c007018ed6d84b795be77803276

# Enable gogcli runtime wiring for opted-in local OpenClaw containers. Default: false.
# Per-agent keyring passwords are written through the gogcli keyring-secret API;
# do not put Google OAuth credentials or keyring passwords in this file.
GOGCLI_ENABLED=false

# Seed vendored ClawSec OpenClaw security skills (suite, soul-guardian, scanner, etc.)
# as builtin skills and default-install the protection set on agents. Default: true.
# Packages are AGPL-3.0; see app/services/clawsec_skill_files/NOTICE.
CLAWSEC_SKILLS_ENABLED=true


# === Process Role / Docker Entrypoint ============================================

# Roles for this backend instance: all, api, worker, connector, bootstrap.
# Multiple roles: comma-separated, e.g. "api,worker".  Default: all.
PROCESS_ROLE=all

# Allow alembic migration failure to be non-fatal.  Default: false.
ALLOW_MIGRATION_FAILURE=false

# Entrypoint start command (override the default uvicorn invocation).
# Default: uvicorn app.main:app --host 0.0.0.0 --port 8000
# START_COMMAND=uvicorn app.main:app --host 0.0.0.0 --port 8000


# === Proxy / Shadowsocks (Discord) ===============================================

# Optional: path to JSON config file with Shadowsocks proxy nodes for Discord.
# Default: /data/ss-nodes.json (inside Docker container).
# SS_CONFIG_FILE=/data/ss-nodes.json

# Optional: single Shadowsocks node via env vars (alternative to SS_CONFIG_FILE).
# Both SS_SERVER and SS_PASSWORD required to activate env-based node.
# SS_SERVER=10.0.0.1
# SS_PORT=1080
# SS_PASSWORD=your-ss-password
# SS_METHOD=chacha20-ietf-poly1305

# Optional: override proxy for Discord API calls (set automatically by ss-local).
# Format: socks5h://host:port  (note: socks5h means DNS resolves on proxy side).
# DISCORD_PROXY=socks5h://127.0.0.1:1080

# Optional: generic HTTPS proxy picked up by Discord, Teams, Google Workspace.
# Format: http://host:port or socks5h://host:port.
# HTTPS_PROXY=http://127.0.0.1:1080


# === IM Integrations - Teams / Slack / WeChat / DingTalk / WeCom ================

# Optional: Microsoft Teams tenant ID for bot authentication.
# TEAMS_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: Atlassian API key for Rovo tools.  Read by tool_seeder at startup.
# ATLASSIAN_API_KEY=your-atlassian-api-key


# === ClawHub / Skill Marketplace =================================================

# ClawHub API base URL.  Default: https://clawhub.ai/api.
CLAWHUB_BASE=https://clawhub.ai/api

# ClawHub mirror base URL (for China region).  Default: https://cn.clawhub-mirror.com/api.
CLAWHUB_MIRROR_BASE=https://cn.clawhub-mirror.com/api


# === Browser / Chromium (for PDF/image rendering) ===============================

# Optional: path to Chrome/Chromium binary.  Auto-detected if not set.
# CHROME_BIN=/usr/bin/chromium


# === Docker Build Args (build-time only, not runtime) ============================
#
# These are used during `docker build`.  They are NOT read by the app at runtime.
# Set them with: docker build --build-arg APT_MIRROR=mirrors.ustc.edu.cn ...
#

# Optional: APT package mirror (e.g. mirrors.ustc.edu.cn for China).
# APT_MIRROR=

# Optional: pip index URL for build-time dependency install.
# MARACLAW_PIP_INDEX_URL=https://pypi.example.com/simple

# Optional: pip trusted-host for the custom index URL.
# MARACLAW_PIP_TRUSTED_HOST=pypi.example.com


# === Local Development / Runner Scripts ==========================================
#
# These are used by start-from-docker.sh.
# Not all are consumed by pydantic-settings - some are shell-script only.
#

# Optional: host port mapped to container 8000.  Default: 8000.
# PORT=8000

# Optional: Docker image name for start-from-docker.sh.  Default: maraclaw-backend:local.
# IMAGE_NAME=maraclaw-backend:local

# Optional: Docker container name.  Default: maraclaw-backend.
# CONTAINER_NAME=maraclaw-backend

# Optional: host data directory mounted at /data in container.  Default: ./.docker-data.
# DATA_DIR=./.docker-data

# Optional: path to .env file for docker run --env-file.  Default: .env (if present).
# ENV_FILE=.env

# Optional: run container in detached mode.  Default: 0.
# DETACH=0

# Optional: always pull base Docker image before build.  Default: 0.
# PULL=0

# ─────────────────────────────────────────────────────────────
# AgentBay SDK (wuying-agentbay-sdk)
# Used as a fallback when no per-agent / global Tool.config api_key is set.
# Get the key from https://agentbay.console.aliyun.com/ → Service Management.
# ─────────────────────────────────────────────────────────────

# Optional fallback API key. Preferred path is Company Settings → Tools →
# AgentBay: Browser Navigate, but this env var works if no DB row has a key.
# AGENTBAY_API_KEY=your-agentbay-api-key-here

# Optional: region for AgentBay cloud sessions. Defaults to the key's
# registered region (typically cn-shanghai).
# AGENTBAY_REGION_ID=cn-shanghai

# Optional: override the API gateway endpoint.
# Default: wuyingai.cn-shanghai.aliyuncs.com
# AGENTBAY_ENDPOINT=wuyingai.cn-shanghai.aliyuncs.com

# Optional: request timeout in milliseconds. Default: 60000.
# AGENTBAY_TIMEOUT_MS=60000

# Optional fallback for the cloud-desktop OS (computer_* tools). DB tool config
# wins; this env var fills in when no os_type is stored. One of: linux, windows.
# Default: linux.
AGENTBAY_OS_TYPE=linux

GOGCLI_SHA256=sha256:4abde90c4e74ceb125f3fdd87676ff7958e89f7820978ffa11de26aee06e721c
GOGCLI_VERSION=0.37.0
