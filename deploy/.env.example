# Copy to deploy/.env, fill every blank, then from the repository root:
# docker compose --env-file deploy/.env up -d --build
# Never commit deploy/.env. Single quotes protect literal $ and # in dotenv values.
SECRET_KEY=
JWT_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_PASSWORD_URLENCODED=
REDIS_PASSWORD=
REDIS_PASSWORD_URLENCODED=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
API_DOMAIN=
ADMIN_DOMAIN=
MEMBER_DOMAIN=
# Absolute Linux host paths; DATA_DIR must already exist, TLS_PEM_PATH must be a file.
DATA_DIR=
TLS_PEM_PATH=

# Stable patch pins as of 2026-10-13; update deliberately (see README for sources).
POSTGRES_TAG=18.6-alpine
REDIS_TAG=8.10.2-alpine
HAPROXY_TAG=3.4.6-alpine
RELEASE_TAG=local
WEB_NODE_VERSION=26.11.1

# Optional per-container limits for an 8-CPU / 16-GiB host (not reservations).
# API controls do not change the independent background/bootstrap budgets.
ENGINE_CPUS=1
ENGINE_MEMORY=2g
BACKGROUND_CPUS=1
BACKGROUND_MEMORY=2g
BOOTSTRAP_CPUS=1
BOOTSTRAP_MEMORY=1g
POSTGRES_CPUS=1.5
POSTGRES_MEMORY=3g
REDIS_CPUS=0.5
REDIS_MEMORY=1g
WEB_CPUS=0.25
WEB_MEMORY=128m
INGRESS_CPUS=0.5
INGRESS_MEMORY=256m

# Optional engine Settings (e.g. LLM provider/model/keys, OPENCLAW_IMAGE) can be
# added here. This file is injected only into engine processes, never frontends.
# Other optional Compose controls and resource budgets are documented in README.
