# Public Vite config for the admin console (never put server secrets here).
# Leave empty in local dev to use same-origin + Vite proxy (/api → engine).
# Never set this to http://0.0.0.0:8000 - 0.0.0.0 is a bind address, not a client host.
VITE_API_BASE_URL=

# Optional: override the Vite dev proxy target (default http://127.0.0.1:8000)
# VITE_DEV_API_PROXY=http://127.0.0.1:8000
